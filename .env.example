# Copy to .env and fill in the keys you have. One provider is enough to follow along.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default provider used by common/llm.py: anthropic | openai | ollama
LLM_PROVIDER=anthropic
# Optional: override the provider's default model (see DEFAULT_MODELS in common/llm.py)
LLM_MODEL=

# Local models via Ollama (https://ollama.com) - OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1

# Client behaviour
LLM_MAX_RETRIES=3
LLM_TIMEOUT=120
# Print a one-line usage/cost summary after every call (1 = on)
LLM_LOG=0
