# Copy to .env and fill in. NEVER commit the real file.
# A JSON list of key entries (hash a key with: python -c "import hashlib;print(hashlib.sha256(b'YOUR-KEY').hexdigest())")
COPILOT_KEYS=[{"user": "alice", "key_sha256": "<64 hex characters>", "rpm": 60, "burst": 10, "daily_tokens": 200000, "max_concurrent": 4, "max_tokens_cap": 400}]
COPILOT_ADMIN_TOKEN=change-me
